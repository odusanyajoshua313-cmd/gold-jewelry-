# ==========================================================
# Goldplugdami Environment Variables Template (.env.example)
# ==========================================================
# Copy this file to .env for local development.
# In production, set these variables in your Vercel Project Settings:
# Settings -> Environment Variables
# ==========================================================

# 1. Supabase Project Credentials (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Administrator Access Token
ADMIN_TOKEN=
